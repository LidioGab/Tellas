{
  "appId": "com.tellas.app",
  "productName": "Tellas",
  "electronVersion": "29.4.6",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "publish": {
    "provider": "github",
    "owner": "LidioGab",
    "repo": "Tellas",
    "releaseType": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../packages/native-audio/build/Release/native_audio.node",
      "to": "native_audio.node"
    },
    {
      "from": "../../packages/native-audio/index.js",
      "to": "packages/native-audio/index.js"
    }
  ],
  "artifactName": "Tellas-Setup-${version}.${ext}",
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Tellas",
    "uninstallDisplayName": "Tellas",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico"
  },
  "asar": true,
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**"
  ]
}
