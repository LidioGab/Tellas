# ─── Tellas Backend Environment Configuration ──────────────────────────────
PORT=3001
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Active media transport (backend only; never expose the API token to Vite/renderer)
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_API_TOKEN=

# Tellas Session Secret (required in production; set the real value with Fly secrets)
TELLAS_SESSION_SECRET=

# Token & Session TTLs (seconds)
LIVEKIT_TOKEN_TTL=1800
TELLAS_SESSION_TTL=43200

# Quotas & Limits
MAX_ACTIVE_ROOMS=100
MAX_PARTICIPANTS_PER_ROOM=20
MAX_PUBLISHERS_PER_ROOM=4

# Reconnect Grace Period (milliseconds)
ROOM_RECONNECT_GRACE_MS=30000

# Publisher reservation timeout (milliseconds)
STREAM_RESERVATION_TTL_MS=30000
