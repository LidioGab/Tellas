# ─── Tellas Backend Environment Configuration ──────────────────────────────
PORT=3001
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Tellas Session Secret (must be at least 32 random characters in production)
TELLAS_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Token & Session TTLs (seconds)
LIVEKIT_TOKEN_TTL=1800
TELLAS_SESSION_TTL=43200

# Quotas & Limits
MAX_ACTIVE_ROOMS=100
MAX_PARTICIPANTS_PER_ROOM=20
MAX_PUBLISHERS_PER_ROOM=4

# Reconnect Grace Period (milliseconds)
ROOM_RECONNECT_GRACE_MS=30000
